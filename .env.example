# Copie este arquivo para .env e preencha UMA das opções abaixo.
# Sem nada configurado, o clone roda em modo demonstração (respostas fixas).

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=            # opcional; se vazio, usa o primeiro modelo da lista

# --- Google Gemini (tem cota grátis; chave em https://aistudio.google.com/apikey) ---
# GEMINI_API_KEY=...
# Sem OPENAI_MODEL, o padrão é gemini-flash-latest, com gemini-flash-lite-latest de reserva.

# --- Ollama (local, grátis) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2

# --- LM Studio (local) ---
# OPENAI_BASE_URL=http://localhost:1234/v1

# --- OpenRouter, Groq ou outro compatível com a API da OpenAI ---
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=...
# OPENAI_MODELS=modelo-a,modelo-b   # limita a lista do seletor de modelos

# --- Modelos de reserva (qualquer provedor) ---
# Se o modelo pedido estiver sobrecarregado, sem cota ou não existir, tenta estes em ordem.
# OPENAI_FALLBACK_MODELS=modelo-b,modelo-c

# --- Opções gerais ---
# PORT=3000
# HOST=127.0.0.1           # use 0.0.0.0 para abrir no celular da mesma rede
# APP_NAME=ChatGPT
# SYSTEM_PROMPT=           # instruções extras enviadas em toda conversa
